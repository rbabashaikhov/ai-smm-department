# ---------------------------------------------------------------------------
# AI SMM Department — environment template.
# Copy to .env (local) or ai-smm.env (VPS, mode 600). Never commit a filled
# copy: .gitignore already excludes .env and .env.*
# ---------------------------------------------------------------------------

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=

# --- Langfuse -------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Threads --------------------------------------------------------------
THREADS_ACCESS_TOKEN=
THREADS_API_BASE_URL=https://graph.threads.net

# --- Public media storage -------------------------------------------------
# Threads fetches media over public HTTPS, so an image must be published to
# the storage before the post is created.
#
# local : the storage directory is bind-mounted into this process. Use this
#         when the storage and the worker share a host: no SSH key, no root
#         login, no network round trip. This is how the VPS runs.
# sftp  : upload over SSH. Use this when the storage is on another host.
#         Default, so existing setups keep working unchanged.
STORAGE_MODE=sftp

# Required in both modes. Must be https:// — Threads refuses plain HTTP.
STORAGE_PUBLIC_BASE_URL=
THREADS_STORAGE_PREFIX=ai-smm/threads

# --- local mode -----------------------------------------------------------
# The one directory this process may write to, and the path it corresponds
# to under STORAGE_PUBLIC_BASE_URL. A remote path outside the prefix is
# refused, so the uploader cannot reach another project's media even if the
# mount were wider than it should be.
STORAGE_LOCAL_ROOT=/srv/ai-smm/media
STORAGE_LOCAL_PREFIX=ai-smm/threads

# --- sftp mode ------------------------------------------------------------
# There are no built-in defaults here: a stale default used to upload to a
# decommissioned host while reporting success.
STORAGE_SSH_HOST=
STORAGE_SSH_PORT=22
STORAGE_SSH_USER=
# Either a key path or a password.
STORAGE_SSH_KEY_PATH=
STORAGE_SSH_PASSWORD=
STORAGE_REMOTE_ROOT=

# --- Database -------------------------------------------------------------
# PostgreSQL is the single source of truth for the publication queue.
# Inside the compose network the host is the existing Postgres container.
AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm:CHANGE_ME@<postgres-container>:5432/ai_smm

# --- Runtime --------------------------------------------------------------
# Read-only mount of the knowledge base inside the container.
AI_SMM_KNOWLEDGE_ROOT=/srv/ai-smm/knowledge
# Base for the repo-relative image paths stored in publications.images
# ("knowledge/projects/<id>/assets/x.jpg"), i.e. the parent of the mount
# above. Leave unset in a source checkout to use the repository root.
AI_SMM_MEDIA_ROOT=/srv/ai-smm
AI_SMM_WORKER_ID=worker-1

# true  = evaluate the queue and record what would happen, send nothing.
# false = publish for real. Only flip this after a specific post is approved.
AI_SMM_DRY_RUN=true

# --- Scheduling -----------------------------------------------------------
AI_SMM_POLL_INTERVAL_SECONDS=60
# Operator timezone for entering and displaying schedules. Storage is UTC.
AI_SMM_DISPLAY_TZ=Europe/Moscow
AI_SMM_LEASE_SECONDS=900
AI_SMM_MAX_ATTEMPTS=5
AI_SMM_MIN_PUBLISH_INTERVAL_SECONDS=300
AI_SMM_DAILY_PUBLISH_LIMIT=20
AI_SMM_BATCH_SIZE=1
AI_SMM_MISFIRE_GRACE_SECONDS=3600

# --- HTTP API (control plane) ---------------------------------------------
# The API reads and edits the metadata around the queue (identity,
# membership, project settings). It never publishes: a publication reaches
# Threads only when the worker claims it.
#
# Absolute session lifetime and idle timeout, in seconds.
AI_SMM_API_SESSION_LIFETIME_SECONDS=604800
AI_SMM_API_SESSION_IDLE_SECONDS=86400
# Secure attribute on the smm_session cookie. Leave unset (true) in
# production; set to false only for a local plain-HTTP run, where a
# browser would otherwise refuse to send the cookie back.
AI_SMM_API_COOKIE_SECURE=true

# --- Logging and health ---------------------------------------------------
LOG_LEVEL=INFO
# json (production) or text (local reading)
LOG_FORMAT=json
# Healthcheck fails when the last cycle is older than
# POLL_INTERVAL * HEALTH_STALE_FACTOR.
AI_SMM_HEALTH_STALE_FACTOR=3
