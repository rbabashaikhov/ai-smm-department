# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets. Covers .env, .env.local and the container runtime file
# ai-smm.env, which holds the database password and API credentials and
# lives on the VPS at mode 600.
.env
.env.*
*.env
!.env.example
# Host-specific files of the Control Center: Docker target (engine id),
# the recorded PostgreSQL identity and the agreed migration window.
control-center.target
control-center.identity
control-center.window
# Written during a deployment: backup evidence and the off-host attestation.
control-center.backup-evidence*
control-center.offhost-ack

# Tool caches
.ruff_cache/

# Local publication state
/data/publications/
/backups/
/logs/

# Local runtime data
*.sqlite
*.sqlite3
*.db

# OS and editor files
.DS_Store
.vscode/
