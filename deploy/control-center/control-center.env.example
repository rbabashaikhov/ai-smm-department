# Control Center -- CONTAINER environment. SECRET once filled in.
#
# Copy to control-center.env next to compose.control-center.yml, then
#   chmod 600 control-center.env
# cc-compose.sh refuses the file if group or others can read it, and if it
# holds any key other than the one below. Never commit the filled copy
# (.gitignore excludes *.env); never copy the worker's ai-smm.env here.
#
# Everything else the API needs -- read-only mode, docs off, no Threads or
# OpenAI credentials -- is a literal in compose.control-center.yml, and
# those literals take precedence over this file.
#
# Exactly one key. KEY=value, no quotes, no `export`.

# The existing ai_smm database, by the database container's name on the
# shared network. Same role as the worker today: see
# docs/control-center-deployment.md, "Database role".
AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm:CHANGE_ME@<postgres-container>:5432/ai_smm
