# Control Center -- the PostgreSQL identity the deployment gates require
# (cc-gate.sh). Host-specific, not secret: never commit the filled copy
# (.gitignore).
#
# Copy to control-center.identity next to compose.control-center.yml and
# fill it from the DEPLOYMENT RECORD -- the values confirmed by the
# read-only pre-deployment gate. Never fill it from the live host in the
# same session: a value read from the instance being checked proves
# nothing. If the gate refuses, stop; do not edit this file to make it pass.
#
# Exactly these five keys. KEY=value, no quotes, no `export`.

# The database container's NAME. It must also be the host in the worker's
# and control-center.env's database URL (not an alias).
SMM_CC_PG_CONTAINER=<postgres-container>

# docker inspect --format '{{.Id}}' <postgres-container>   (full 64 hex)
SMM_CC_PG_CONTAINER_ID=<64-hex container id>

# SELECT system_identifier FROM pg_control_system();
SMM_CC_PG_SYSTEM_IDENTIFIER=<system identifier>

# SELECT oid FROM pg_database WHERE datname = 'ai_smm';
SMM_CC_PG_DATABASE_OID=<oid>

# The live worker's container; its AI_SMM_DATABASE_URL is the reference.
SMM_CC_WORKER_CONTAINER=<worker-container>
