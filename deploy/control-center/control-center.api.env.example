# Control Center -- smm-api's CONTAINER environment. SECRET once filled in.
#
# Copy to control-center.api.env next to compose.control-center.yml, then
#   chmod 600 control-center.api.env
# cc-compose.sh refuses the file if group or others can read it, and if it
# holds any key other than the one below. Never commit the filled copy
# (.gitignore excludes *.env).
#
# smm-api ONLY. migrate and cli keep the owner role in control-center.env.
#
# The API's least-privilege role, ai_smm_cc (SMM-024C-2): created by
# ai_smm_cc.grants.sql, password set interactively with psql's \password.
# Same container, port and database as control-center.env; only the user
# and the password differ. Before `up` and `restart`, the API role gate
# (cc-gate.sh) refuses any other user, any other host/port/database, the
# owner's URL, and a role that ai_smm_cc.verify.sql does not pass.
# See docs/least-privilege-role.md.
#
# Exactly one key. KEY=value, no quotes, no `export`. The password
# URL-encoded.

AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm_cc:CHANGE_ME@<postgres-container>:5432/ai_smm
