# Control Center -- compose INTERPOLATION variables (not secret).
#
# Copy to control-center.compose.env next to compose.control-center.yml,
# in the Control Center's own directory (never the worker's). Read only
# through cc-compose.sh, which passes it with --env-file and refuses any
# key not listed here -- in particular no COMPOSE_* variable, which could
# rename the project.
#
# Exactly these two keys. KEY=value, no quotes, no `export`.

# The FULL git commit both images were built from: 40 lowercase hex
# characters, `git rev-parse HEAD`. The images are ai-smm-api:<this> and
# ai-smm-web:<this>, and each must carry the OCI label
# org.opencontainers.image.revision equal to exactly this value.
SMM_CC_VERSION=0123456789abcdef0123456789abcdef01234567

# The EXISTING Docker network the database container is reached on. It is
# attached as external: never created, changed or removed by this project.
SMM_CC_SHARED_NETWORK=<shared-network>
