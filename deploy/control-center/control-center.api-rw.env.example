# Control Center -- smm-api's environment in BUSINESS-MUTATION mode.
# SECRET once filled in.
#
# Copy to control-center.api-rw.env next to compose.control-center.yml, then
#   chmod 600 control-center.api-rw.env
# cc-compose.sh refuses the file if group or others can read it, and if it
# holds any key other than the one below. Never commit the filled copy
# (.gitignore excludes *.env).
#
# Read only by `cc-compose.sh mutations enable` and, while the mode file
# control-center.mutations names the running release, by every later verb
# (compose.control-center.mutations.yml loads it INSTEAD of
# control-center.api.env). Without a mode file it is never loaded.
#
# The mutation role, ai_smm_cc_rw (SMM-025C, FU-025B-1): created by
# ai_smm_cc_rw.grants.sql, password set interactively with psql's
# \password. Same container, port and database as control-center.env;
# its own user and password, never ai_smm_cc's. The API role gate
# (cc-gate.sh) refuses any other user, any other host/port/database, the
# owner's or the read-only role's URL, and a role that
# ai_smm_cc_rw.verify.sql does not pass. See docs/mutation-role.md.
#
# Exactly one key. KEY=value, no quotes, no `export`. The password
# URL-encoded.

AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm_cc_rw:CHANGE_ME@<postgres-container>:5432/ai_smm
