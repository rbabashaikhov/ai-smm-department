# Compose interpolation for compose.generation.yml (passed with --env-file).
# Not secret. Exactly these keys.

# The release image already loaded on the host: ai-smm:<this value>
# (the publish worker's image of the same release, e.g. 9ff2260).
SMM_GEN_VERSION=CHANGE_ME
# The Docker network the database container is attached to.
SMM_GEN_SHARED_NETWORK=<shared-network>
# Host path of the knowledge base (read-only); this is the default.
SMM_GEN_KNOWLEDGE_PATH=/srv/ai-smm/knowledge
