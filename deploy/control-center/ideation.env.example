# Topic ideation worker -- CONTAINER environment. SECRET once filled in.
#
# Copy to ideation.env next to compose.ideation.yml, then
#   chmod 600 ideation.env
# Never commit the filled copy (.gitignore excludes *.env). Never copy the
# publish worker's, the generation worker's or the Control Center's env
# files here.
#
# Exactly two keys. KEY=value, no quotes, no `export`. Everything else the
# worker needs is a literal in compose.ideation.yml, and those literals take
# precedence over this file.

# The existing ai_smm database, by the database container's name on the
# shared network, as the dedicated login ai_smm_ideation (never the owner,
# ai_smm_cc, ai_smm_cc_rw, ai_smm_auth or ai_smm_generation). Its password
# is set by the operator with psql's \password after
# ai_smm_ideation.grants.sql; never on a command line.
AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm_ideation:CHANGE_ME@<postgres-container>:5432/ai_smm

# Leave EMPTY until real ideation is approved: the worker then refuses to
# start (exit 2) and nothing can call a model. A real key comes from a
# dedicated OpenAI project with its own spend limit; the application has no
# spend cap of its own.
OPENAI_API_KEY=
