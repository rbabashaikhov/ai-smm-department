# Control Center -- smm-auth's CONTAINER environment. SECRET once filled in.
#
# Copy to control-center.auth.env next to compose.control-center.yml, then
#   chmod 600 control-center.auth.env
# cc-compose.sh refuses the file if group or others can read it, and if it
# holds any key other than the one below. Never commit the filled copy
# (.gitignore excludes *.env).
#
# smm-auth ONLY (SMM-025D, ADR-024C-3A): the sign-in service's role,
# ai_smm_auth, created by ai_smm_auth.grants.sql after
# smm_auth.functions.sql; password set interactively with psql's
# \password. Same container, port and database as control-center.env;
# only the user and the password differ. Before `up` and `restart`, the
# auth role gate (cc-gate.sh) refuses any other user, any other
# host/port/database, a URL equal to any other service's, and a role that
# ai_smm_auth.verify.sql does not pass.
#
# Exactly one key. KEY=value, no quotes, no `export`. The password
# URL-encoded.

AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm_auth:CHANGE_ME@<postgres-container>:5432/ai_smm
