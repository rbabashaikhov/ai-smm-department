# Generation worker -- CONTAINER environment. SECRET once filled in.
#
# Copy to generation.env next to compose.generation.yml, then
#   chmod 600 generation.env
# Never commit the filled copy (.gitignore excludes *.env). Never copy the
# publish worker's ai-smm.env or the Control Center's env files here.
#
# Exactly two keys. KEY=value, no quotes, no `export`. Everything else the
# worker needs -- no Threads, storage or tracing credentials, knowledge
# read-only, one instance -- is a literal in compose.generation.yml, and those
# literals take precedence over this file.

# The existing ai_smm database, by the database container's name on the
# shared network, as the dedicated login ai_smm_generation (never the owner,
# ai_smm_cc or ai_smm_auth). Its password is set by the operator with psql's
# \password after ai_smm_generation.grants.sql; never on a command line.
AI_SMM_DATABASE_URL=postgresql+psycopg://ai_smm_generation:CHANGE_ME@<postgres-container>:5432/ai_smm

# Leave EMPTY until real generation is approved: nothing can then call a
# model. A real key comes from a dedicated OpenAI project, never the key of
# another project. The application has NO spend cap of its own: any limit
# is set on the OpenAI side and is the owner's to configure and watch.
OPENAI_API_KEY=
